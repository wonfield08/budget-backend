DATABASE_URL="postgresql://user:password@localhost:5432/budget_db?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="1h"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# --- docker-compose only (docker-compose.yml reads these to build DATABASE_URL
# for the `app`/`postgres`/`postgres-exporter` services; not used by `npm run dev`) ---
POSTGRES_USER="budget"
POSTGRES_PASSWORD="change-this-to-a-long-random-string"
POSTGRES_DB="budget_db"
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="change-this-to-a-long-random-string"
